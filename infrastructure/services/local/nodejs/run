#!/bin/bash

echo "[$(date -u)][NODEJS] Started!"

cd /var/www/admin-next

if [[ -n "$CI" ]]; then
    # Cypress restores the shared test build before starting the application container.
    if [[ "$CIRCLE_JOB" == *"cypress"* ]]; then
        exec pm2 start --no-daemon bash --name "admin-next" -- /var/www/.circleci/admin-next-build.sh start
    else
        exec sleep 10
    fi
fi
