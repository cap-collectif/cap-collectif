{% if private is not defined %}
    {% set private = false %}
{% endif %}
{% set author = user|capco_author_profile(private) %}
{% set format = (format is defined) ? format : 'avatar' %}
{% if format == 'avatar' %}
    {% set width = 'lg' %}
{% elseif format == 'avatar_source' %}
    {% set width = 'md' %}
{% elseif format == 'profile' %}
    {% set width = 'xl' %}
{% endif %}
{% set classes = (classes is defined) ? ' ' ~ classes : '' %}

{% if author.url %}
    <a {% if link_classes is defined %}class="{{ link_classes }}"{% endif %} href="{{ author.url }}" title="{{ 'usernames-profile'|trans({'userName': author.name}, 'CapcoAppBundle') }}">
        <span style="display: none" class="mr-10">{{ author.name }}</span>
{% else %}
    <span {% if link_classes is defined %}class="{{ link_classes }}"{% endif %}>
{% endif %}
     {{ react_render_component('UserAvatarApp', { 'props': {'userId': author.globalId, 'size': width } }) }}
{% if author.url %}
    </a>
{% else %}
    </span>
{% endif %}
