{#
    Email UI components mirroring the @cap-collectif/ui design system with Outlook compatible tables.
    Colors are design system tokens: gray.100 #F7F7F8, gray.150 #E8EBED, gray.300 #BEC4CB,
    gray.700 #545E68, gray.800 #3D454C, gray.900 #272B30.
    Icons are PNG files generated by scripts/generate-email-icons.cjs.
#}

{% macro icon_url(baseUrl, name) -%}
    {{ baseUrl ~ asset('image/email/' ~ name ~ '.png') }}
{%- endmacro %}

{# Gray icon that switches to its light variant in dark mode. #}
{% macro icon(baseUrl, name, size) -%}
    <img class="light-img" src="{{ _self.icon_url(baseUrl, name) }}" width="{{ size }}" height="{{ size }}" alt="" style="display:block;width:{{ size }}px;height:{{ size }}px;border:0;" />
    <!--[if !mso]><!--><img class="dark-img" src="{{ _self.icon_url(baseUrl, name ~ '-dark') }}" width="{{ size }}" height="{{ size }}" alt="" style="display:none;width:{{ size }}px;height:{{ size }}px;border:0;" /><!--<![endif]-->
{%- endmacro %}

{# Variants: primary (filled), secondary (outlined) or tertiary (link). #}
{% macro button(label, href, variant, colors) -%}
    {% if 'tertiary' == variant %}
        <a href="{{ href }}" class="link-primary" style="font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;color:{{ colors.primary }};text-decoration:none;">{{ label }}</a>
    {% else %}
        {% set isPrimary = 'primary' == variant %}
        <table role="presentation" border="0" cellspacing="0" cellpadding="0" style="border-collapse:separate;">
            <tr>
                <td class="{{ isPrimary ? 'button-primary' : 'button-secondary' }}" align="center" bgcolor="{{ isPrimary ? colors.primary : '#FFFFFF' }}" style="border-radius:4px;border:1px solid {{ colors.primary }};mso-padding-alt:11px 16px;">
                    <a href="{{ href }}" class="{{ isPrimary ? 'button-primary-text' : 'link-primary' }}" style="display:inline-block;padding:11px 16px;font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:600;color:{{ isPrimary ? colors.primaryText : colors.primary }};text-decoration:none;">{{ label }}</a>
                </td>
            </tr>
        </table>
    {% endif %}
{%- endmacro %}

{# Dark mode colors of each variant are declared by tag_dark_styles in the head. #}
{% macro tag(label, variant, tagColors) -%}
    <span class="tag tag-{{ variant }}" style="display:inline-block;padding:2px 8px;border-radius:4px;background-color:{{ tagColors[variant].background }};color:{{ tagColors[variant].color }};font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:600;white-space:nowrap;">{{ label }}</span>
{%- endmacro %}

{% macro tag_dark_styles(tagColors) -%}
    {% for variant, colors in tagColors %}
        .tag-{{ variant }} { background-color: {{ colors.darkBackground }} !important; color: {{ colors.darkColor }} !important; }
    {% endfor %}
{%- endmacro %}

{#
    Activity line: gray badge with a gray icon, then the text. Callers must escape dynamic parts of the content.
    The optional aside (e.g. a button) is aligned right on the text line when there is room, and wraps below it otherwise.
    Outlook desktop ignores floats and always stacks it below.
    The text vertical padding matches the 44px button height so both stay centered on the same line.
#}
{% macro activity_row(baseUrl, icon, content, aside = null) -%}
    <table role="presentation" border="0" cellspacing="0" cellpadding="0" width="100%">
        <tr>
            <td class="badge" width="32" height="32" align="center" valign="middle" bgcolor="#F7F7F8" style="width:32px;height:32px;border-radius:16px;">
                {{ _self.icon(baseUrl, 'activity-' ~ icon, 20) }}
            </td>
            <td class="text-primary" valign="middle" style="padding-left:12px;font-family:'Open Sans',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#272B30;">
                {{ (aside ? '<div style="display:inline-block;max-width:100%;padding:10px 16px 10px 0;">' ~ content ~ '</div><div style="float:right;">' ~ aside ~ '</div>' : content)|raw }}
            </td>
        </tr>
    </table>
{%- endmacro %}
