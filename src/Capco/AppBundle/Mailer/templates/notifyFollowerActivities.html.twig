{% import '@CapcoMail/components/ui.html.twig' as ui %}
{% set font = "font-family:'Open Sans',Helvetica,Arial,sans-serif;" %}
{% set logo = app_logo_url() %}
{% set summaryDate = sendAt|localizeddate('none', 'none', user_locale, timezone, 'd MMMM') %}
<!DOCTYPE html>
<html lang="{{ user_locale|slice(0, 2) }}" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>{{ 'your-activity-summary-of'|trans({'{siteName}': siteName}, 'CapcoAppBundle', user_locale) }}</title>
    <!--[if mso]>
    <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
    <![endif]-->
    <style type="text/css">
        :root { color-scheme: light dark; supported-color-schemes: light dark; }
        body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
        h1, h2, h3, h4, p { margin: 0; }
        a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }

        @media screen and (max-width: 600px) {
            .container { width: 100% !important; }
            .block { border-radius: 0 !important; }
            .block-gap { height: 12px !important; line-height: 12px !important; }
            .block-padding { padding: 32px 8px 8px 8px !important; }
            .header-padding { padding: 24px 20px !important; }
            .block-title-padding { padding: 0 12px !important; }
            .card-padding { padding: 20px 12px !important; }
            .card-gap { height: 8px !important; line-height: 8px !important; }
            .proposal-title { font-size: 16px !important; line-height: 24px !important; }
            .proposal-cover { height: 128px !important; }
            .end-button { padding-top: 24px !important; }
            .post-gap { height: 24px !important; line-height: 24px !important; }
            .desktop-only { display: none !important; }
            .mobile-only { display: block !important; max-height: none !important; overflow: visible !important; }
            .news-text { padding: 24px 20px !important; }
        }

        @media (prefers-color-scheme: dark) {
            .body-bg { background-color: #3D454C !important; }
            .block { background-color: #272B30 !important; }
            .block-watermark { background-image: url('{{ ui.icon_url(baseUrl, 'project-watermark-dark') }}') !important; }
            .card { background-color: #3D454C !important; }
            .badge { background-color: #272B30 !important; }
            .news-card { border-color: #545E68 !important; }
            .logo { background-color: #FFFFFF !important; border-radius: 4px; }
            .text-primary { color: #F7F7F8 !important; }
            .text-secondary { color: #BEC4CB !important; }
            .link-primary { color: {{ colors.primaryDark }} !important; }
            .button-primary { background-color: {{ colors.primaryDark }} !important; border-color: {{ colors.primaryDark }} !important; }
            .button-primary-text { color: #272B30 !important; }
            .button-secondary { background-color: transparent !important; border-color: {{ colors.primaryDark }} !important; }
            .light-img { display: none !important; }
            .dark-img { display: block !important; }
            {{ ui.tag_dark_styles(tagColors) }}
        }
    </style>
</head>
<body class="body-bg" style="margin:0;padding:0;background-color:#FFFFFF;">
    {# Preheader: shown next to the subject in the inbox. #}
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#FFFFFF;opacity:0;">
        {{ 'email.follower-activities.preheader'|trans({}, 'CapcoAppBundle', user_locale) }}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
    </div>
    <table role="presentation" class="body-bg" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF">
        <tr>
            <td align="center" style="padding:0;">
                <!--[if mso]><table role="presentation" width="600" border="0" cellspacing="0" cellpadding="0"><tr><td><![endif]-->
                <table role="presentation" class="container" width="600" border="0" cellspacing="0" cellpadding="0" style="width:600px;max-width:600px;">
                    <tr><td class="block-gap" height="16" style="height:16px;line-height:16px;font-size:0;">&nbsp;</td></tr>

                    {# Header block #}
                    <tr>
                        <td class="block header-padding" bgcolor="#F7F7F8" style="padding:32px 48px;border-radius:8px;">
                            <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                                <tr>
                                    <td valign="middle" style="{{ font }}">
                                        {% if logo %}
                                            <img class="logo" src="{{ logo }}" height="40" alt="{{ siteName }}" style="display:block;height:40px;width:auto;max-width:200px;border:0;" />
                                        {% else %}
                                            <span class="text-primary" style="{{ font }}font-size:16px;line-height:24px;font-weight:600;color:#272B30;">{{ siteName }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-secondary" valign="middle" align="right" style="padding-left:16px;white-space:nowrap;{{ font }}font-size:14px;line-height:20px;color:#545E68;">
                                        {{ 'email.follower-activities.summary-of'|trans({'{date}': summaryDate}, 'CapcoAppBundle', user_locale) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-secondary" style="padding-top:24px;{{ font }}font-size:16px;line-height:24px;color:#545E68;">
                                        {{ 'email.follower-activities.greeting'|trans({'{username}': username}, 'CapcoAppBundle', user_locale) }}
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding-top:4px;">
                                        <h1 class="text-primary" style="margin:0;{{ font }}font-size:24px;line-height:32px;font-weight:600;color:#272B30;">
                                            {{ 'email.follower-activities.introduction'|trans({'num': proposalCount}, 'CapcoAppBundle', user_locale) }}
                                        </h1>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {% for project in projects %}
                        <tr><td class="block-gap" height="16" style="height:16px;line-height:16px;font-size:0;">&nbsp;</td></tr>
                        <tr>
                            {# The watermark is decorative: clients without background images simply ignore it. #}
                            <td class="block block-padding block-watermark" bgcolor="#F7F7F8" background="{{ ui.icon_url(baseUrl, 'project-watermark') }}" style="padding:32px 24px 24px 24px;border-radius:8px;background-color:#F7F7F8;background-image:url('{{ ui.icon_url(baseUrl, 'project-watermark') }}');background-repeat:no-repeat;background-position:top right;background-size:88px 88px;">
                                <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td class="block-title-padding" style="padding:0 24px 24px 24px;">
                                            <p class="text-secondary" style="margin:0;{{ font }}font-size:14px;line-height:20px;color:#545E68;">
                                                {{ 'email.follower-activities.in-participatory-project'|trans({}, 'CapcoAppBundle', user_locale) }}
                                            </p>
                                            <h2 class="text-primary" style="margin:4px 0 0 0;{{ font }}font-size:16px;line-height:24px;font-weight:600;color:#272B30;">{{ project.title }}</h2>
                                        </td>
                                    </tr>
                                    {% for proposal in project.proposals %}
                                        {% if not loop.first %}
                                            <tr><td class="card-gap" height="12" style="height:12px;line-height:12px;font-size:0;">&nbsp;</td></tr>
                                        {% endif %}
                                        <tr>
                                            <td>
                                                {% include '@CapcoMail/Follower/proposalActivities.html.twig' %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    {% for opinion in project.opinions %}
                                        {% if not loop.first or project.proposals is not empty %}
                                            <tr><td class="card-gap" height="12" style="height:12px;line-height:12px;font-size:0;">&nbsp;</td></tr>
                                        {% endif %}
                                        <tr>
                                            <td>
                                                {% include '@CapcoMail/Follower/opinionActivities.html.twig' %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </table>
                            </td>
                        </tr>
                    {% endfor %}

                    {% if hiddenProposalCount > 0 %}
                        <tr><td class="block-gap" height="16" style="height:16px;line-height:16px;font-size:0;">&nbsp;</td></tr>
                        <tr>
                            <td class="block header-padding" bgcolor="#F7F7F8" style="padding:24px 48px;border-radius:8px;">
                                <p class="text-primary" style="margin:0;{{ font }}font-size:16px;line-height:24px;font-weight:600;color:#272B30;">
                                    {{ 'email.follower-activities.other-proposals'|trans({'num': hiddenProposalCount}, 'CapcoAppBundle', user_locale) }}
                                </p>
                                <a href="{{ urlManagingFollowings }}" class="link-primary" style="{{ font }}font-size:16px;line-height:24px;font-weight:600;color:{{ colors.primary }};text-decoration:none;">
                                    {{ 'email.follower-activities.find-in-followings'|trans({'num': hiddenProposalCount}, 'CapcoAppBundle', user_locale) }}
                                </a>
                            </td>
                        </tr>
                    {% endif %}

                    {# Footer #}
                    <tr>
                        <td class="text-secondary" align="center" style="padding:32px 24px;{{ font }}font-size:14px;line-height:20px;color:#545E68;">
                            <p style="margin:0;">
                                {{ 'email.follower-activities.footer-reason'|trans({'num': proposalCount}, 'CapcoAppBundle', user_locale) }}
                            </p>
                            <p style="margin:0;">
                                <a href="{{ urlManagingFollowings }}" class="text-secondary" style="color:#545E68;text-decoration:underline;">{{ 'email.follower-activities.manage-followings'|trans({}, 'CapcoAppBundle', user_locale) }}</a>
                            </p>
                            <p style="margin:8px 0 0 0;">
                                {{ 'email.follower-activities.powered-by'|trans({'{siteName}': siteName}, 'CapcoAppBundle', user_locale) }}
                            </p>
                        </td>
                    </tr>
                </table>
                <!--[if mso]></td></tr></table><![endif]-->
            </td>
        </tr>
    </table>
</body>
</html>
